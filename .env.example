# --- Recognition model ---
DEMO_MODE=false                        # false = load production 61-class ONNX model; true = heuristic demo
SIGNBRIDGE_ONNX_MODEL_PATH=checkpoints/full_61/model.onnx
SIGNBRIDGE_LABELS_PATH=checkpoints/full_61/model_labels.json
SIGNBRIDGE_MAX_SEQ_LEN=48

# --- TTS provider: browser | azure | google ---
TTS_PROVIDER=browser
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=

# --- STT provider: browser | whisper ---
STT_PROVIDER=browser
WHISPER_MODE=api
OPENAI_API_KEY=

# --- Optional LLM sentence-polishing / conversation assistance ---
LLM_PROVIDER=none                     # none | openai | gemini
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# --- Server ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500
SIGNBRIDGE_DB_PATH=signbridge.db

# Never commit a real .env file with actual keys filled in.
